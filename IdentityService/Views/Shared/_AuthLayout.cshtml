<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - SmartMonitoring</title>
    <style>
        body {
            font-family: system-ui, sans-serif;
            background: #f5f7fb;
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }
        .card {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
            max-width: 420px;
            width: 100%;
            padding: 2rem;
        }
        h1 { font-size: 1.5rem; margin-top: 0; }
        p { color: #444; line-height: 1.5; }
        label { display: block; margin-top: 1rem; font-weight: 600; }
        input {
            width: 100%;
            padding: 0.65rem;
            margin-top: 0.35rem;
            box-sizing: border-box;
            border: 1px solid #ccd3df;
            border-radius: 8px;
        }
        button {
            margin-top: 1.5rem;
            padding: 0.7rem 1.2rem;
            cursor: pointer;
            border: 0;
            border-radius: 8px;
            background: #2563eb;
            color: #fff;
            font-weight: 600;
            width: 100%;
        }
        .error { color: #b00020; margin-top: 1rem; }
        .success { color: #0f766e; margin-top: 1rem; }
        .hint { font-size: 0.9rem; color: #666; }
        a { color: #2563eb; }
    </style>
</head>
<body>
    <div class="card">
        @RenderBody()
    </div>
</body>
</html>
