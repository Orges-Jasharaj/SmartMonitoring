{
  "Observability": {
    "ServiceName": "NotificationService",
    "EnableLoki": true,
    "LokiUrl": "http://localhost:3100",
    "EnableOpenTelemetry": true,
    "OtlpEndpoint": "http://localhost:4317",
    "EnablePrometheus": true,
    "RestrictMetricsToLocalhost": true,
    "EnableRequestLogging": true
  },
  "NotificationApiKey": {
    "ApiKey": "dev-notification-api-key-change-in-production"
  },
  "Email": {
    "Enabled": true,
    "Host": "localhost",
    "Port": 1025,
    "UseSsl": false,
    "FromAddress": "alerts@smartmonitoring.local",
    "FromName": "SmartMonitoring Alerts"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
