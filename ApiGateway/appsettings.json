{
  "Observability": {
    "ServiceName": "ApiGateway",
    "EnableLoki": true,
    "LokiUrl": "http://localhost:3100",
    "EnableOpenTelemetry": true,
    "OtlpEndpoint": "http://localhost:4317",
    "EnablePrometheus": true,
    "RestrictMetricsToLocalhost": true,
    "EnableRequestLogging": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/identity/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/identity"
          }
        ]
      },
      "audit-route": {
        "ClusterId": "audit-cluster",
        "Match": {
          "Path": "/audit/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/audit"
          }
        ]
      },
      "monitoring-route": {
        "ClusterId": "monitoring-cluster",
        "Match": {
          "Path": "/monitoring/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/monitoring"
          }
        ]
      },
      "notification-route": {
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "/notifications/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/notifications"
          }
        ]
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:8080/"
          }
        }
      },
      "audit-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:8081/"
          }
        }
      },
      "monitoring-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:8082/"
          }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:8083/"
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}
